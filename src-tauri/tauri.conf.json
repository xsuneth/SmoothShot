{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmoothShot",
  "version": "0.1.0",
  "identifier": "com.smoothshot.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SmoothShot",
        "width": 1220,
        "height": 54,
        "minWidth": 1120,
        "minHeight": 54,
        "maxHeight": 54,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true
      },
      {
        "label": "editor",
        "title": "SmoothShot Editor",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
