{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmoothShot",
  "version": "0.1.0",
  "identifier": "com.smoothshot.app",
  "build": {
    "beforeDevCommand": "bun run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SmoothShot",
        "width": 746,
        "height": 60,
        "minWidth": 231,
        "minHeight": 52,
        "maxHeight": 60,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": false,
        "shadow": false,
        "maximizable": false,
        "minimizable": false
      },
      {
        "label": "editor",
        "title": "SmoothShot Editor",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "visible": false,
        "decorations": false
      },
      {
        "label": "camera-preview",
        "title": "Camera Preview",
        "width": 250,
        "height": 250,
        "minWidth": 250,
        "minHeight": 250,
        "maxWidth": 250,
        "maxHeight": 250,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": false,
        "shadow": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
